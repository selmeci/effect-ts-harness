{
  "name": "effect-ts-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "lint": "oxlint --deny-warnings .",
    "verify": "nx affected -t verify",
    "verify:all": "nx run-many -t verify",
    "harness": "node --import ./tools/node-ts-resolver.mjs apps/harness-cli/src/index.ts",
    "effect-graph:check": "node --import ./tools/node-ts-resolver.mjs apps/harness-cli/src/index.ts plan-check --graph-only",
    "benchmark": "node --import ./tools/node-ts-resolver.mjs tools/benchmark/run.mjs",
    "scenario": "node tools/scenario/run.mjs"
  },
  "devDependencies": {
    "@effect/tsgo": "0.48.0",
    "@nx/js": "23.2.1",
    "@nx/oxlint": "23.2.1",
    "nx": "23.2.1",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "ts-pattern": "5.9.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
