{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "ignorePatterns": ["repos/**", "node_modules/**", "dist/**", "coverage/**"],
  "jsPlugins": ["./tools/oxlint/syntax-bans.js", "@nx/oxlint/boundaries-plugin"],
  "rules": {
    "effecttsgo/unstable-api-usage": "off",
    "effecttsgo/lazy-effect": "error",
    "effecttsgo/redundant-or-die": "error",
    "effecttsgo/schema-number": "error",
    "effecttsgo/prefer-typed-schema-decoder": "error",
    "effecttsgo/return-effect-in-gen": "error",
    "effecttsgo/run-effect-inside-effect": "error",
    "effecttsgo/try-catch-in-effect-gen": "error",
    "effecttsgo/unnecessary-effect-gen": "error",
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "enforceBuildableLibDependency": true,
        "depConstraints": [
          { "sourceTag": "scope:web", "onlyDependOnLibsWithTags": ["type:contract"] },
          { "sourceTag": "type:contract", "onlyDependOnLibsWithTags": ["type:contract"] },
          { "sourceTag": "type:domain", "onlyDependOnLibsWithTags": ["type:contract", "type:domain", "type:service"] },
          { "sourceTag": "type:service", "onlyDependOnLibsWithTags": ["type:contract", "type:domain", "type:service"] },
          { "sourceTag": "type:infra", "onlyDependOnLibsWithTags": ["type:contract", "type:domain", "type:service", "type:infra"] },
          { "sourceTag": "type:app", "onlyDependOnLibsWithTags": ["type:contract", "type:domain", "type:service", "type:infra", "type:app"] },
          { "sourceTag": "*", "onlyDependOnLibsWithTags": ["*"] }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "libs/**/src/**/*.ts",
        "apps/**/src/**/*.ts",
        "libs/**/test/fixtures/**/*.ts",
        "apps/**/test/fixtures/**/*.ts"
      ],
      "rules": {
        "harness/syntax-bans": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-orm", "drizzle-orm/*"],
                "message": "drizzle-orm is infra-only — import it only in type:infra libraries; repositories decode rows into contract Schemas (docs/mvp_v2.md §10)."
              },
              {
                "group": ["alchemy", "alchemy/*"],
                "message": "alchemy is infra/app-only — resources and bindings may live only in type:infra libraries and apps/sample/alchemy.run.ts (docs/mvp_v2.md §9)."
              },
              {
                "group": ["@effect/sql-*"],
                "message": "@effect/sql-* drivers are infra-only — import them only in type:infra libraries (docs/mvp_v2.md §10)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/**/test/**/*.ts", "apps/**/test/**/*.ts"],
      "rules": {
        "harness/test-integrity": "error"
      }
    },
    {
      "files": ["**/infra/src/**/*.ts", "**/infra/test/**/*.ts", "apps/sample/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
