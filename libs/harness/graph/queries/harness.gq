// Named GQ Queries for @harness/graph over the Clean-Slate PERA Levi Hypergraph (G_Levi)
// Bipartite Levi Incidence Graph: V = V_E u V_R, E = E_role (RelationNode -> EntityNode only).

query resolve_effect_fn($spanOrQualname: String) {
  match {
    $fn: EffectFn
    $fn.spanName = $spanOrQualname or $fn.qualname = $spanOrQualname
  }
  return {
    $fn.qualname,
    $fn.spanName,
    $fn.packageTag,
    $fn.file,
    $fn.line,
    $fn.successType,
    $fn.isStub,
    $fn.archimateLayer,
    $fn.archimateAspect,
    $fn.archimateElementType
  }
}

query find_service_providers($tagId: String) {
  match {
    $lf: LayerFlow
    $layer: ServiceLayer
    $tag: ServiceTag
    $lf playsProviderLayerRole $layer
    $lf playsProvidedServiceRole $tag
    $tag.tagId = $tagId or $tag.name = $tagId or $tag.qualname = $tagId
  }
  return {
    $layer.qualname as layerQualname,
    $layer.layerKind as layerKind,
    $layer.packageTag as packageTag,
    $layer.file as file,
    $tag.tagId as tagId
  }
}

query find_callers($target: String) {
  match {
    $sig: EffectSignature
    $caller: EffectFn
    $callee: EffectFn
    $sig playsCallerRole $caller
    $sig $rel:playsCalleeRole $callee
    $callee.qualname = $target or $callee.spanName = $target
  }
  return {
    $caller.qualname as caller,
    $rel.archimateRelation as rel,
    $callee.qualname as callee
  }
}

query find_callees($caller: String) {
  match {
    $sig: EffectSignature
    $src: EffectFn
    $callee: EffectFn
    $sig playsCallerRole $src
    $sig $rel:playsCalleeRole $callee
    $src.qualname = $caller or $src.spanName = $caller
  }
  return {
    $src.qualname as src,
    $rel.archimateRelation as rel,
    $callee.qualname as callee
  }
}

query find_tests_reaching($callee: String) {
  match {
    $tt: TraceabilityTuple
    $test: VitestCase
    $fn: EffectFn
    $tt playsExercisingTestRole $test
    $tt playsExercisedSpanRole $fn
    $fn.qualname = $callee or $fn.spanName = $callee
  }
  return {
    $test.testId as testId,
    $test.testFile as testFile,
    $test.testName as testName
  }
}

query ontology_layer_nodes($layer: String) {
  match {
    $node: EffectFn
    $node.archimateLayer = $layer
  }
  return {
    $node
  }
}

query ontology_governed_by($symbol: String) {
  match {
    $tt: TraceabilityTuple
    $doc: AdrDoc
    $target: EffectFn
    $tt $rel:playsGoverningAdrRole $doc
    $tt playsRealizingFnRole $target
    $target.qualname = $symbol or $target.spanName = $symbol
  }
  return {
    $doc,
    $rel.archimateRelation as rel,
    $target
  }
}

query untested_domain_fns() {
  match {
    $fn: EffectFn
    ($fn.packageTag = "domain" or $fn.packageTag = "contract") and $fn.isStub = false
    not {
      $tt: TraceabilityTuple
      $test: VitestCase
      $tt playsExercisingTestRole $test
      $tt playsExercisedSpanRole $fn
    }
  }
  return {
    $fn.qualname as qualname,
    $fn.spanName as spanName,
    $fn.file as file
  }
}
