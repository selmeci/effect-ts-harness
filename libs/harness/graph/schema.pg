// PERA Bipartite Levi Incidence Hypergraph PG-Schema (v2 — RFC-0009)
// Bipartite Levi Incidence Graph: V = V_E u V_R, E = E_role (RelationNode -> EntityNode only).

node EffectFn
  @instruction("An Effect-TS function or pure .decide/.evolve unit. Connect only via EffectSignature, TraceabilityTuple, or HttpEndpointTuple—never directly to another EntityNode.")
{
  qualname: String @key @description("Canonical workspace path#exportName identity")
  spanName: String @index @description("Effect.fn span identifier or exported function name")
  packageTag: enum(contract, domain, service, infra, app, unknown) @index
  file: String @index
  line: I32
  successType: String?
  isStub: Bool? @index @description("True during plan-check when body uses stub<A, E, R>()")
  payloadSchemas: [String]?
  inputSchema: String?
  outputSchema: String?
  signatureEmbedding: Vector(768)? @embed("spanName") @index
  archimateLayer: enum(Motivation, Business, Application, Technology, Implementation)? @index
  archimateAspect: enum(Motivation, Behavior, ActiveStructure, PassiveStructure)? @index
  archimateElementType: String? @index
}

node ServiceTag
  @instruction("An Effect Context.Service<Self, Shape>() capability port declared in type:service.")
{
  tagId: String @key @description("Canonical service tag identifier, e.g. @harness/service/WorkspaceFs")
  qualname: String @index
  name: String @index
  identifier: String? @index
  packageTag: enum(contract, domain, service, infra, app, unknown)? @index
  file: String @index
  line: I32?
  capabilityEmbedding: Vector(768)? @embed("name") @index
  archimateLayer: enum(Motivation, Business, Application, Technology, Implementation)? @index
  archimateAspect: enum(Motivation, Behavior, ActiveStructure, PassiveStructure)? @index
  archimateElementType: String? @index
}

node ServiceLayer
  @instruction("An Effect Layer implementation providing or requiring ServiceTag capabilities.")
{
  qualname: String @key @description("Canonical workspace path#exportName identity of the Layer")
  layerKind: enum(live, test, emulated, infra)? @index
  packageTag: enum(contract, domain, service, infra, app, unknown)? @index
  file: String @index
  line: I32?
  archimateLayer: enum(Motivation, Business, Application, Technology, Implementation)? @index
  archimateAspect: enum(Motivation, Behavior, ActiveStructure, PassiveStructure)? @index
  archimateElementType: String? @index
}

node TaggedError
  @instruction("A Schema.TaggedError domain or service failure type.")
{
  errorTag: String @key @description("Canonical error tag name")
  qualname: String @index
  tag: String? @index
  file: String @index
  line: I32?
  errorEmbedding: Vector(768)? @embed("errorTag") @index
  archimateLayer: enum(Motivation, Business, Application, Technology, Implementation)? @index
  archimateAspect: enum(Motivation, Behavior, ActiveStructure, PassiveStructure)? @index
  archimateElementType: String? @index
}

node SchemaDef
  @instruction("An Effect Schema definition or branded domain value type in type:contract.")
{
  schemaName: String @key @description("Canonical schema export name")
  qualname: String @index
  name: String @index
  packageTag: enum(contract, domain, service, infra, app, unknown)? @index
  file: String @index
  line: I32?
  isBranded: Bool? @index
  schemaEmbedding: Vector(768)? @embed("schemaName") @index
  archimateLayer: enum(Motivation, Business, Application, Technology, Implementation)? @index
  archimateAspect: enum(Motivation, Behavior, ActiveStructure, PassiveStructure)? @index
  archimateElementType: String? @index
}

node VitestCase
  @instruction("A Vitest unit or property-based test case exercising EffectFn spans.")
{
  testId: String @key @description("Canonical testFile::testName identifier")
  qualname: String @index
  testFile: String @index
  testName: String @index
  name: String? @index
  file: String? @index
  line: I32?
  lastTreeHash: String?
  isPropertyTest: Bool? @index
  hasNonPrimitiveArbitrary: Bool? @index
  spanTraceBlob: Blob? @description("Runtime span telemetry trace captured during test execution; read via Blob API")
  archimateLayer: enum(Motivation, Business, Application, Technology, Implementation)? @index
  archimateAspect: enum(Motivation, Behavior, ActiveStructure, PassiveStructure)? @index
  archimateElementType: String? @index
}

node PatternDoc
  @instruction("Idiom documentation under agent-patterns/*.md indexed for semantic routing.")
{
  slug: String @key @description("Pattern document slug derived from filename")
  qualname: String @index
  path: String @index
  summary: String @index @description("Concise architectural pattern summary used for BM25 and @embed")
  title: String? @index
  coveredSpans: [String]?
  coveredTags: [String]?
  summaryEmbedding: Vector(768)? @embed("summary") @index
  contentBlob: Blob?
  archimateLayer: enum(Motivation, Business, Application, Technology, Implementation)? @index
  archimateAspect: enum(Motivation, Behavior, ActiveStructure, PassiveStructure)? @index
  archimateElementType: String? @index
}

node AdrDoc
  @instruction("Architecture Decision Record under libs/*/docs/adr/*.md (ArchiMate Motivation Principle).")
{
  id: String @key @description("Canonical ADR identifier, e.g. harness:ADR-0001")
  qualname: String @index
  title: String @index
  status: enum(accepted, proposed, superseded, deprecated) @index
  date: String?
  path: String @index
  enforcedByFiles: [String]
  referencedSpans: [String]?
  referencedServices: [String]?
  referencedErrors: [String]?
  titleEmbedding: Vector(768)? @embed("title") @index
  markdownBlob: Blob?
  archimateLayer: enum(Motivation, Business, Application, Technology, Implementation)? @index
  archimateAspect: enum(Motivation, Behavior, ActiveStructure, PassiveStructure)? @index
  archimateElementType: String? @index
}

node EarsSpec
  @instruction("EARS behavioral specification under libs/*/docs/specs/*.md (ArchiMate Motivation Requirement).")
{
  id: String @key @description("Canonical EARS spec identifier, e.g. harness:SPEC-0001")
  qualname: String @index
  title: String @index
  status: enum(accepted, proposed, superseded, deprecated) @index
  date: String?
  path: String @index
  enforcedByFiles: [String]
  informedByAdrs: [String]?
  referencedSpans: [String]?
  referencedServices: [String]?
  referencedErrors: [String]?
  titleEmbedding: Vector(768)? @embed("title") @index
  markdownBlob: Blob?
  archimateLayer: enum(Motivation, Business, Application, Technology, Implementation)? @index
  archimateAspect: enum(Motivation, Behavior, ActiveStructure, PassiveStructure)? @index
  archimateElementType: String? @index
}

node EffectSignature
  @instruction("Reified Levi RelationNode capturing an EffectFn's call, service requirement, error, and schema incidence.")
{
  relationId: String @key @description("Deterministic Levi relation identifier")
  qualname: String @index
  callerQualname: String @index
  file: String @index
  line: I32
}

node LayerFlow
  @instruction("Reified Levi RelationNode capturing ServiceLayer provision, requirement, and failure incidence.")
{
  relationId: String @key @description("Deterministic Levi relation identifier")
  qualname: String @index
  layerQualname: String @index
  file: String @index
  line: I32
}

node TraceabilityTuple
  @instruction("Reified Levi RelationNode linking AdrDoc/EarsSpec/PatternDoc/VitestCase to realized/specified symbols.")
{
  relationId: String @key @description("Deterministic Levi relation identifier")
  qualname: String @index
  adrId: String? @index
  earsSpecId: String? @index
  requirementId: String? @index
  earsPattern: String? @index
  targetSymbolQualname: String @index
  derivationProofBlob: Blob?
}

node HttpEndpointTuple
  @instruction("Reified Levi RelationNode linking an HttpApi endpoint to its handler, request/response schemas, and errors.")
{
  relationId: String @key @description("Deterministic Levi relation identifier")
  qualname: String @index
  endpointGroup: String @index
  endpointName: String @index
  method: String @index
  path: String @index
  handlerQualname: String? @index
  file: String @index
  line: I32
}

node MigrationTuple
  @instruction("Reified Levi RelationNode tracking a SQL migration module and its verifying test.")
{
  relationId: String @key @description("Deterministic Levi relation identifier")
  qualname: String @index
  migrationId: String @index
  engine: String @index
  moduleFile: String @index
  isDestructive: Bool @index
  line: I32
}

node GraphPolicy
  @instruction("In-graph architectural invariant enforced by harness_ontology_check and harness verify; run enabled checkQuery queries and fix any returned rows.")
{
  policyId: String @key @description("Unique policy rule identifier")
  name: String @index
  statement: String @description("Human- and agent-readable invariant rule and remediation")
  severity: enum(error, warning, info) @index
  checkQuery: String? @description("Stored .gq query name returning violating rows")
  enabled: Bool @index
}

edge PlaysCallerRole: EffectSignature -> EffectFn @card(0..)
  @instruction("Incidence edge from EffectSignature to the calling EffectFn.")
{
  @key(@src, @dst, role)
  role: String @index @description("Role tag: caller")
  archimateRelation: String @index
}

edge PlaysCalleeRole: EffectSignature -> EffectFn @card(0..)
  @instruction("Incidence edge from EffectSignature to a called EffectFn.")
{
  @key(@src, @dst, role)
  role: String @index @description("Role tag: callee")
  archimateRelation: String @index
  callCount: I64?
  receiverLayer: String?
}

edge PlaysRequiresServiceRole: EffectSignature -> ServiceTag @card(0..)
  @instruction("Incidence edge from EffectSignature to a required ServiceTag capability.")
{
  @key(@src, @dst, role)
  role: String @index @description("Role tag: requires-service")
  archimateRelation: String @index
}

