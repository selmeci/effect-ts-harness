{
  "name": "@harness/sample-infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "nx": {
    "tags": [
      "type:infra"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --strict --project tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "migration:check": "node --import ../../../tools/node-ts-resolver.mjs scripts/check-migrations.mjs",
    "migration:generate": "drizzle-kit generate",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run migration:check"
  },
  "dependencies": {
    "@effect/sql-d1": "4.0.0",
    "@effect/sql-sqlite-do": "4.0.0",
    "@harness/sample-contract": "workspace:*",
    "@harness/sample-domain": "workspace:*",
    "@harness/sample-service": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0",
    "ts-pattern": "5.9.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@harness/graph": "workspace:*",
    "@harness/ingest": "workspace:*",
    "@types/node": "26.6.5",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "vitest": "5.0.3"
  }
}
