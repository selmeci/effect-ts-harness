{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "floatingEffect": "error",
          "lazyEffect": "error",
          "redundantOrDie": "error",
          "schemaNumber": "error",
          "preferTypedSchemaDecoder": "error",
          "returnEffectInGen": "error",
          "runEffectInsideEffect": "error",
          "tryCatchInEffectGen": "error",
          "unnecessaryEffectGen": "error",
          "unstableApiUsage": "off"
        },
        "ignoreEffectSuggestionsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false,
        "ignoreEffectErrorsInTscExitCode": false
      }
    ]
  },
  "exclude": ["repos", "node_modules", "dist", "coverage", ".nx"]
}

