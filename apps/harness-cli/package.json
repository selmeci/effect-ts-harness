{
  "name": "harness-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --strict --project tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "verify": "node -e \"\"",
    "start": "node --import ../../tools/node-ts-resolver.mjs src/index.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@harness/contract": "workspace:*",
    "@harness/decision": "workspace:*",
    "@harness/gates": "workspace:*",
    "@harness/graph": "workspace:*",
    "@harness/infra": "workspace:*",
    "@harness/ingest": "workspace:*",
    "@harness/service": "workspace:*",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "26.6.5",
    "vitest": "5.0.3"
  },
  "nx": {
    "tags": [
      "type:app"
    ]
  }
}
