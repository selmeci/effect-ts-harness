{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "cli": {
    "analytics": false
  },
  "cacheDirectory": ".nx/cache",
  "ignore": ["repos/**", "docs/**", "agent-patterns/**", "adapters/**"],
  "plugins": [
    "@nx/js",
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "oxlint"
      }
    }
  ],
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/.oxlintrc.json",
      "{workspaceRoot}/.oxfmtrc.json",
      "{workspaceRoot}/tools/oxlint/syntax-bans.js",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/package.json"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"]
  },
  "targetDefaults": {
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json",
        "{workspaceRoot}/tools/oxlint/syntax-bans.js"
      ]
    },
    "format:check": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.oxfmtrc.json"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "openapi:check": {
      "cache": true,
      "inputs": ["default"]
    },
    "migration:check": {
      "cache": true,
      "inputs": ["default"]
    },
    "verify": {
      "cache": true,
      "dependsOn": ["typecheck", "lint", "test"]
    },
    "effect-graph:check": {
      "cache": true,
      "inputs": ["default"]
    }
  }
}
